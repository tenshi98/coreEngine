<?php
require_once __DIR__ . '/EnvLoader.php';

/*******************************************************************************************************************/
/*                                    Variables de entorno (credenciales de BD)                                    */
/*******************************************************************************************************************/
// Las const de clase no admiten llamadas a funciones (getenv), por eso se resuelven primero
// como constantes globales, una vez que EnvLoader ya cargó el .env.
define('ENV_DB_ADMIN_HOSTNAME', getenv('DB_ADMIN_HOSTNAME'));
define('ENV_DB_ADMIN_USERNAME', getenv('DB_ADMIN_USERNAME'));
define('ENV_DB_ADMIN_PASSWORD', getenv('DB_ADMIN_PASSWORD'));
define('ENV_DB_ADMIN_DATABASE', getenv('DB_ADMIN_DATABASE'));
define('ENV_DB_ADMIN_CHARSET', getenv('DB_ADMIN_CHARSET'));
define('ENV_DB_ADMIN_PORT', (int) getenv('DB_ADMIN_PORT'));

define('ENV_DB_MYSQL1_HOSTNAME', getenv('DB_MYSQL1_HOSTNAME'));
define('ENV_DB_MYSQL1_USERNAME', getenv('DB_MYSQL1_USERNAME'));
define('ENV_DB_MYSQL1_PASSWORD', getenv('DB_MYSQL1_PASSWORD'));
define('ENV_DB_MYSQL1_DATABASE', getenv('DB_MYSQL1_DATABASE'));
define('ENV_DB_MYSQL1_CHARSET', getenv('DB_MYSQL1_CHARSET'));
define('ENV_DB_MYSQL1_PORT', (int) getenv('DB_MYSQL1_PORT'));

define('ENV_DB_POSTGRES1_HOSTNAME', getenv('DB_POSTGRES1_HOSTNAME'));
define('ENV_DB_POSTGRES1_USERNAME', getenv('DB_POSTGRES1_USERNAME'));
define('ENV_DB_POSTGRES1_PASSWORD', getenv('DB_POSTGRES1_PASSWORD'));
define('ENV_DB_POSTGRES1_DATABASE', getenv('DB_POSTGRES1_DATABASE'));
define('ENV_DB_POSTGRES1_PORT', (int) getenv('DB_POSTGRES1_PORT'));

define('ENV_DB_SQLITE1_ROUTE', getenv('DB_SQLITE1_ROUTE'));

define('ENV_DB_MONGO1_HOST', getenv('DB_MONGO1_HOST'));
define('ENV_DB_MONGO1_DATABASE', getenv('DB_MONGO1_DATABASE'));

define('ENV_DB_JIG1_ROUTE', getenv('DB_JIG1_ROUTE'));

define('ENV_DB_REDIS1_ROUTE', getenv('DB_REDIS1_ROUTE'));

/*******************************************************************************************************************/
/*                                              Se define la clase                                                 */
/*******************************************************************************************************************/
class ConfigDataBase{
    /*****************************************************/
    // Variables para MySQL
    const MySQL_ADMIN = [
        'HOSTNAME' => ENV_DB_ADMIN_HOSTNAME,
        'USERNAME' => ENV_DB_ADMIN_USERNAME,
        'PASSWORD' => ENV_DB_ADMIN_PASSWORD,
        'DATABASE' => ENV_DB_ADMIN_DATABASE,
        'CHARSET'  => ENV_DB_ADMIN_CHARSET,
        'PORT'     => ENV_DB_ADMIN_PORT,
    ];
    /*****************************************************/
    // Variables para MySQL
    const MySQL_1 = [
        'HOSTNAME' => ENV_DB_MYSQL1_HOSTNAME,
        'USERNAME' => ENV_DB_MYSQL1_USERNAME,
        'PASSWORD' => ENV_DB_MYSQL1_PASSWORD,
        'DATABASE' => ENV_DB_MYSQL1_DATABASE,
        'CHARSET'  => ENV_DB_MYSQL1_CHARSET,
        'PORT'     => ENV_DB_MYSQL1_PORT,
    ];
    /*****************************************************/
    // Variables para MySQL
    const PostGreSQL_1 = [
        'HOSTNAME' => ENV_DB_POSTGRES1_HOSTNAME,
        'USERNAME' => ENV_DB_POSTGRES1_USERNAME,
        'PASSWORD' => ENV_DB_POSTGRES1_PASSWORD,
        'DATABASE' => ENV_DB_POSTGRES1_DATABASE,
        'PORT'     => ENV_DB_POSTGRES1_PORT,
    ];
    /*****************************************************/
    // Variables para SQLite
    const SQLite_1 = [
        'ROUTE' => ENV_DB_SQLITE1_ROUTE,
    ];
    /*****************************************************/
    // Variables para Mongo DB
    const MongoDB_1 = [
        'HOST'     => ENV_DB_MONGO1_HOST,
        'DATABASE' => ENV_DB_MONGO1_DATABASE,
    ];
    /*****************************************************/
    // Variables para Jig
    const Jig_1 = [
        'ROUTE' => ENV_DB_JIG1_ROUTE,
    ];
    /*****************************************************/
    // Variables para Redis
    const Redis_1 = [
        'ROUTE' => ENV_DB_REDIS1_ROUTE,
    ];

}
