    /*****************************************************/
    // Variables globales del servidor
    const GmailSender = [
        'SERVERURL'    => ENV_MAIL_GMAIL_SERVERURL,
        'SERVERPORT'   => ENV_MAIL_GMAIL_SERVERPORT,
