#### Proteger el propio htaccess
<Files .htaccess>
    Require all denied
</Files>
#### Cuerpo maximo de la peticion: 64 KiB (sin <FilesMatch "^\."> para que .well-known llegue a index.php)
LimitRequestBody 65536
#### No permitir el listado de archivos
Options -Indexes
#### Propaga la cabecera Authorization a PHP
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    #### index.php se sirve tal cual (evita el bucle de reescritura)
    RewriteRule ^index\.php$ - [L]
    #### views/ nunca se sirve (403)
    RewriteRule ^views/ - [F]
    #### Todo lo demas se reescribe a index.php
    RewriteRule .* index.php [L,QSA]
</IfModule>
